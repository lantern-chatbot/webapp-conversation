# APP ID
NEXT_PUBLIC_APP_ID=
# Dify APP API key (server only - never prefix this with NEXT_PUBLIC_)
DIFY_API_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=
# Signs the session_id cookie (server only). A random string of 32+ characters.
# If unset, a key derived from DIFY_API_KEY is used; rotating that key then resets conversation lists.
SESSION_SECRET=

# Optional Google Sheets logging (server only): off / test / production
CHAT_LOG_MODE=off
CHAT_LOG_URL=
CHAT_LOG_SECRET=
